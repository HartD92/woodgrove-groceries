<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>    
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-woodgrovedemo-FBF1B85E-DADD-4187-9E01-DBB8923E80F7</UserSecretsId>
    <AssemblyVersion>1.0.2.6</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageReference Include="Microsoft.Graph" Version="5.94.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.14.1" />
    <PackageReference Include="Microsoft.Identity.Web.DownstreamApi" Version="3.14.1" />
    <PackageReference Include="Microsoft.Identity.Web.GraphServiceClient" Version="3.14.1" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="3.14.1" />
    <!-- Transitive override: Microsoft.Graph 5.x resolves Microsoft.Kiota.Abstractions 1.17.1,
         which carries GHSA-7j59-v9qr-6fq9 (high severity) — the Kiota redirect handler fails to
         strip Cookie and Proxy-Authorization headers on cross-host/scheme 3xx redirects.
         Fixed in Kiota 1.22.0. Remove these pins once Microsoft.Graph ships a version that
         naturally resolves Kiota >= 1.22.0. -->
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.1" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.22.1" />
  </ItemGroup>

</Project>
