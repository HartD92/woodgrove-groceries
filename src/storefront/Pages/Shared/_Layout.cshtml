@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var brandAssetsBaseUrl = Configuration["BrandAssets:BaseUrl"]?.TrimEnd('/');
    var externalBrandLogoUrl = !string.IsNullOrWhiteSpace(brandAssetsBaseUrl)
        ? $"{brandAssetsBaseUrl}/af-logo.svg"
        : null;
    var externalBrandFaviconUrl = !string.IsNullOrWhiteSpace(brandAssetsBaseUrl)
        ? $"{brandAssetsBaseUrl}/af-favicon.png"
        : null;
    var headerLogoUrl = externalBrandLogoUrl ?? Url.Content("~/images/logo.png");
    var faviconUrl = externalBrandFaviconUrl ?? Url.Content("~/woodgrove-favicon.ico");
    var faviconType = externalBrandFaviconUrl != null ? "image/png" : "image/x-icon";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="@faviconType" href="@faviconUrl">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
        integrity="sha384-Bk5cbLkZQ5raZ0+H2/+VbfYx3WpvxvQK4zqXZr7sYODuaX7bKXoSOnipQxkaS8sv" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/woodgrovedemo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bs-stepper.min.css">
    <link rel="stylesheet" href="~/css/af-theme.css" asp-append-version="true" />

    <!--- Font ---->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="af-theme">
    <header class="header" id="header">
        <div id="headerContainer" class="container af-header-container">
            <nav class="navbar navbar-expand-lg wg-navbar">
                <div class="container-fluid">
                    <a asp-area="" asp-page="/Index" class="brand-shell text-decoration-none">
                        <img src="@headerLogoUrl" height="26" alt="Brand logo" class="brand-mark" />
                        <span class="brand-copy">
                            <span class="brand-wordmark">Woodgrove Groceries</span>
                            <span class="brand-tagline">Curated identity experiences</span>
                        </span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false"
                        aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarContent">
                        <div class="navbar-nav me-auto mb-2">

                        </div>
                        <ul class="navbar-nav">
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
            @RenderSection("Jumbotron", required: false)
            @RenderSection("Waves", required: false)
    </header>

    @RenderSection("FullScreen", required: false)

    <div class="container page-shell">
        <main class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- About this demop -->
    <button id="offcanvasButton" class="btn btn-success" type="button" data-bs-toggle="offcanvas"
        data-bs-target="#offcanvasRight" aria-controls="offcanvasRight" onclick="showUseCase(2);"><i
            class="bi bi-arrow-up-circle fs-3"></i>&nbsp;&nbsp; <span class="fs-5">Select a use case</span></button>

    <div class="offcanvas offcanvas-end" data-bs-scroll="false" tabindex="-1" id="offcanvasRight"
        aria-labelledby="offcanvasRightLabel">
        <div class="offcanvas-header">
            <img src="@headerLogoUrl" height="34" alt="Brand logo" />
            <h3>About the demo</h3>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div id="scroller" style="transform: translate(0px, 0px) translateZ(0px);">
                @if (IsSectionDefined("AboutThisDemo"))
                {
                    @RenderSection("AboutThisDemo", required: false)
                }
                else
                {
                    <partial name="AboutThisDemoPartial" />
                }

            </div>
        </div>
    </div>

    <!-- Feedback button --->
    <div id="feedbackButton">
        <a class="btn btn-success feedback" data-bs-offset="10,-100" data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="hover focus"
            title="Provide feedback" href="https://github.com/microsoft/woodgrove-groceries/issues/new"><i
                class="bi bi-megaphone"></i>&nbsp; Feedback</a>
    </div>

    <!--Image fullscreen-->
    <div class="modal" tabindex="-1" id="imagemodal">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content" style="background-color: black;">
                <div class="modal-body" style="text-align: center;">
                    <a type="button" data-bs-dismiss="modal">
                        <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                             class="imagepreview" style="width: 100%;" alt="">
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div style="height: 80px;"></div>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted af-footer" style="border-top-style: none!important; height: 100px;">
        <svg viewBox="0 -20 700 110" width="100%" height="110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path transform="translate(0, -20)" d="M0,10 c80,-22 240,0 350,18 c90,17 260,7.5 350,-20 v50 h-700"
                fill="#352f39" />
            <path d="M0,10 c80,-18 230,-12 350,7 c80,13 260,17 350,-5 v100 h-700z" fill="#eccabb" />
        </svg>
        <div class="container-fluid footer-text af-footer-text"
            style="width: 100%; top: -60px; position: relative; background-color: #eccabb;">
            &copy; 2025 - Woodgrove Groceries &nbsp; - &nbsp;&nbsp;
            <i class="bi bi-info-circle" aria-hidden="true"></i> <a asp-area="" asp-page="/Help" style="padding-right: 10px;">Help</a>
            <i class="bi bi-lock" aria-hidden="true"></i> <a asp-area="" asp-page="/Privacy" style="padding-right: 10px;">Privacy</a>
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i> <a asp-area="" asp-page="/tos" style="padding-right: 10px;">Terms of
                service</a>
            <i class="bi bi-github" aria-hidden="true"></i> <a href="https://github.com/microsoft/woodgrove-groceries"
                style="padding-right: 10px;">Source code</a>
            <i class="bi bi-github" aria-hidden="true"></i> <a href="https://github.com/microsoft/woodgrove-auth-api"
                style="padding-right: 10px;">Authentication API</a>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
        crossorigin="anonymous"></script>


    <script src="https://cdn.jsdelivr.net/npm/bs-stepper@1.7.0/dist/js/bs-stepper.min.js"
        integrity="sha384-eqEnJ05qXHDr1RVtRHxkDbr0hzBxQBDDTyTYVWBWiaYzSZlkVxkkhhcSKrO8l7p9" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/demos.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false);
</body>

</html>
