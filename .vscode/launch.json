{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Storefront",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-storefront",
      "program": "${workspaceFolder}/src/storefront/bin/Debug/net10.0/woodgrovedemo.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/storefront",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/storefront/Views"
      }
    },
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/api/bin/Debug/net10.0/woodgrove-groceries-api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/api/Views"
      }
    },
    {
      "name": "Auth API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-auth-api",
      "program": "${workspaceFolder}/src/auth-api/bin/Debug/net10.0/woodgroveapi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/auth-api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/auth-api/Views"
      }
    },
    {
      "name": "Graph middleware",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-graph-middleware",
      "program": "${workspaceFolder}/src/graph-middleware/bin/Debug/net10.0/woodgrove-groceries-graph-middleware.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/graph-middleware",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/graph-middleware/Views"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
